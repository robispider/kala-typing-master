---
import T from './T.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<p class="muted narrow">
  <T en="About one-third less modeled finger effort than UniJoy. Common letters within easy reach. One key map, with two ways to type vowels."
     bn="ইউনিজয়ের তুলনায় মডেলের হিসাবে প্রায় এক-তৃতীয়াংশ কম আঙুলের পরিশ্রম। প্রচলিত বর্ণগুলো সহজ নাগালে। একই কি-বিন্যাসে স্বরবর্ণ লেখার দুটি সহজ নিয়ম।" />
</p>
<p class="small muted evidence">
  <strong><T en="4 billion search proposals" bn="৪০০ কোটি অনুসন্ধান-প্রস্তাব" /></strong>
  <span aria-hidden="true"> · </span>
  <strong><T en="Local certificate: 45,526 alternatives checked" bn="স্থানীয় সনদ: ৪৫,৫২৬টি বিকল্প বিন্যাস যাচাই" /></strong>
  <span aria-hidden="true"> · </span>
  <a href={`${base}about/#layout-research`}><T en="See the research" bn="গবেষণা দেখুন" /></a>
</p>
<style>
  .evidence { margin-top: 12px; line-height: 1.8; }
</style>
