[{"id":"text.410a3c3c1f763eacb695e4af","title":"পলাশীর যুদ্ধ","collection":"বিবিধ","genre":"poetry","sources":["https://www.isid.ac.in/~deepayan/bengalionline.net/Archive/zzzMiscellaneous/Poetry/misc.bn.html#008_palaasheera_juddha"],"items":[{"kind":"passage","text":"১\nবৃটিশের রণবাদ্য বাজিল অমনি\nকাঁপাইয়া রণস্থল,\nকাঁপাইয়া গঙ্গাজল,\nঝাঁপাইয়া আম্রবন উঠিল সে ধ্বনি।","edition":false}]}]