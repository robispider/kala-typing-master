---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import LayoutCards from '../../components/LayoutCards.astro';
import { S } from '../../lib/check/strings.ts';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Learn · Kala Learn">
  <section class="wrap head">
    <p class="eyebrow"><T en="Learn" bn="শিখুন" /></p>
    <h1><T en="Pick a keyboard layout" bn="একটি কিবোর্ড লেআউট বেছে নিন" /></h1>
    <p class="muted lede">
      <T
        en="Not sure? If you are new to Bangla typing, start with Kala Goti: familiar UniJoy-style vowels on keys arranged for less effort. If you already type UniJoy, keep your habits with UniJoy. Your system keyboard stays on English — Kala does the Bangla."
        bn="নিশ্চিত নন? বাংলা টাইপিংয়ে নতুন হলে Kala গতি দিয়ে শুরু করুন: পরিচিত ইউনিজয়-ধাঁচের স্বরবর্ণ, কম পরিশ্রমে সাজানো কি। আগে থেকে ইউনিজয়ে লিখলে ইউনিজয়ই রাখুন। আপনার কম্পিউটারের কিবোর্ড ইংরেজিতেই থাকবে — বাংলা লিখবে Kala।"
      />
    </p>
  </section>
  <section class="wrap">
    <LayoutCards />
  </section>
  <section class="wrap">
    <div class="card check">
      <div>
        <h2><T {...S.title} /></h2>
        <p class="muted"><T {...S.entry} /></p>
      </div>
      <a class="btn" href={`${base}check/`}><T {...S.open} /></a>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-top: 48px;
    padding-bottom: 24px;
  }
  .lede {
    max-width: 46em;
    font-size: 1.05rem;
  }
  .check {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
    padding: 18px 22px;
  }
  .check h2 {
    font-size: 1.15rem;
    margin: 0 0 4px;
  }
  .check p {
    margin: 0;
  }
</style>
