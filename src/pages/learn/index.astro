---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import LayoutCards from '../../components/LayoutCards.astro';
import LayoutConfidence from '../../components/LayoutConfidence.astro';
import { S } from '../../lib/check/strings.ts';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Learn · Kala Learn">
  <section class="wrap head">
    <p class="eyebrow"><T en="Learn" bn="শিখুন" /></p>
    <h1><T en="Learn Goti and Jhor" bn="গতি ও ঝড় শিখুন" /></h1>
    <LayoutConfidence />
    <p class="muted small">
      <T
        en="Choose Goti or Jhor below and follow its own key map. Keep your system keyboard on English."
        bn="নিচে গতি বা ঝড় বেছে নিয়ে তার অক্ষরের অবস্থান অনুসরণ করুন। কম্পিউটারের কিবোর্ড ইংরেজিতেই রাখুন।"
      />
    </p>
  </section>
  <section class="wrap">
    <LayoutCards />
  </section>
  <section class="wrap">
    <div class="card check">
      <div>
        <h2><T {...S.title} /></h2>
        <p class="muted"><T {...S.entry} /></p>
      </div>
      <a class="btn" href={`${base}check/`}><T {...S.open} /></a>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-top: 48px;
    padding-bottom: 24px;
  }
  .lede {
    max-width: 46em;
    font-size: 1.05rem;
  }
  .check {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
    padding: 18px 22px;
  }
  .check h2 {
    font-size: 1.15rem;
    margin: 0 0 4px;
  }
  .check p {
    margin: 0;
  }
</style>
