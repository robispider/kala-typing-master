---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
---
<Base title="Research · B01 Goti / Jhor · Kala Learn">
  <div class="wrap research" data-research>
    <header class="intro">
      <p class="eyebrow"><T en="Personal research pilot" bn="ব্যক্তিগত গবেষণার প্রাথমিক পরীক্ষা" /></p>
      <h1><T en="One arrangement. Two typing styles." bn="একটি বিন্যাস। দুই টাইপিং শৈলী।" /></h1>
      <p class="lede"><T en="This historical B01 pilot uses an experimental shared map, separate from ordinary Goti/Jhor courses. Its positions stay fixed while you compare vowel-entry rules. Start with guidance." bn="এই ঐতিহাসিক B01 পরীক্ষায় আলাদা পরীক্ষামূলক অভিন্ন ম্যাপ ব্যবহার করা হয়; সাধারণ গতি ও ঝড় কোর্সের ম্যাপ আলাদা। অক্ষরের অবস্থান একই রেখে স্বরবর্ণ লেখার নিয়ম তুলনা করুন। শুরুতে সাহায্য থাকবে।" /></p>
    </header>

    <section id="rs-setup" class="card panel">
      <h2><T en="Practice, then compare" bn="আগে অনুশীলন, তারপর তুলনা" /></h2>
      <p><T en="Four blocks: Goti → Jhor → Jhor → Goti, reversed next session with the same assistance. Each block has one measured minute of ordinary text and one of vowel/context exercises. Practice and breaks are untimed. Your feedback may favor a style; there is no automatic universal winner." bn="চারটি পর্ব: গতি → ঝড় → ঝড় → গতি। একই সাহায্যের সেটিংয়ে পরের পরীক্ষায় ক্রম উল্টাবে। প্রতিটিতে এক মিনিট সাধারণ লেখা ও এক মিনিট স্বরবর্ণের নিয়ম যাচাই। অনুশীলন ও বিরতির সময় বাঁধা নেই। মতামত থেকে পছন্দ বোঝা যাবে; সবার জন্য স্বয়ংক্রিয় বিজয়ী নেই।" /></p>
      <div class="notice"><T en="Use a physical keyboard. Switch your system input to English and turn off Kala or another Bangla input app while using this page. This page produces the Bangla itself." bn="আসল কিবোর্ড ব্যবহার করুন। এই পাতায় লেখার সময় সিস্টেমের ইনপুট ইংরেজি করুন এবং Kala বা অন্য বাংলা ইনপুট অ্যাপ বন্ধ রাখুন। পাতাটি নিজেই বাংলা তৈরি করে।" /></div>
      <form id="rs-form">
        <div class="settings">
          <label><T en="Previous experience with the entry rules" bn="লেখার নিয়মে আগের অভিজ্ঞতা" /><select id="rs-style-experience"><option value="neither">Neither style / কোনোটিতে নয়</option><option value="goti">Goti or hasant + sign rules / গতি বা হসন্ত + কার</option><option value="jhor">Jhor context-vowel rules / ঝড়ের প্রসঙ্গ-নির্ভর নিয়ম</option><option value="both">Both / দুটিতেই</option></select></label>
          <label><T en="Help during measured blocks" bn="মাপার সময় সাহায্য" /><select id="rs-assistance"><option value="guided">Guided / পরের কি দেখাবে</option><option value="recall">From memory / মনে রেখে, সাহায্য ছাড়া</option></select></label>
          <label><T en="Experience with B01 positions" bn="B01-এর অবস্থানে অভিজ্ঞতা" /><select id="rs-experience"><option value="new">New to B01 / একেবারে নতুন</option><option value="practicing">Practicing / অনুশীলন করছি</option><option value="comfortable">Comfortable / স্বচ্ছন্দে লিখি</option></select></label>
          <label><T en="Keyboard" bn="কিবোর্ড" /><select id="rs-keyboard"><option value="unknown">Choose / বেছে নিন</option><option value="laptop-builtin">Laptop keyboard / ল্যাপটপের কিবোর্ড</option><option value="external">External keyboard / আলাদা কিবোর্ড</option></select></label>
          <label><T en="Fingers you will use" bn="কোন আঙুলে লিখবেন" /><select id="rs-fingering"><option value="usual-fingers">My usual fingers / নিজের অভ্যাসমতো</option><option value="following-traditional-guide">Follow the finger guide / দেখানো আঙুলে</option></select></label>
        </div>
        <p class="tiny muted"><T en="The finger guide uses traditional fingering. Key events cannot tell us which finger you actually used. Guided and memory tests stay separate; this is not a prediction of your eventual speed." bn="আঙুলের নির্দেশনা প্রচলিত নিয়মের। কোন আঙুলে চাপছেন তা কি-এর রেকর্ড থেকে জানা যায় না। সাহায্য নিয়ে ও মনে রেখে লেখা আলাদা থাকবে; এটি ভবিষ্যতের গতির পূর্বাভাস নয়।" /></p>
        <button class="btn primary" type="submit" id="rs-prepare"><T en="Start with guided practice" bn="সাহায্য নিয়ে অনুশীলন শুরু করুন" /></button>
        <p id="rs-setup-status" role="status"></p>
      </form>
      <details id="rs-previous" hidden><summary><T en="Your last copied report on this browser" bn="এই ব্রাউজারে আপনার শেষ প্রতিবেদন" /></summary><textarea id="rs-previous-text" readonly aria-label="Previous research report"></textarea></details>
    </section>

    <section id="rs-work" hidden>
      <div class="work-top"><h2 id="rs-heading"></h2><div class="actions"><button class="btn" id="rs-pause" type="button"><T en="Pause / resume" bn="বিরতি / চালু" /></button><button class="btn" id="rs-stop" type="button"><T en="Stop & keep report" bn="থামুন ও প্রতিবেদন রাখুন" /></button></div></div>
      <p id="rs-status" class="muted" role="status" aria-live="polite"></p>
      <p id="rs-ime" class="notice" hidden><T en="Another input method was detected. Switch to English, turn off the Bangla input app, then resume. No typing is recorded while paused." bn="অন্য ইনপুট পদ্ধতি শনাক্ত হয়েছে। ইংরেজি ইনপুট করুন, বাংলা ইনপুট অ্যাপ বন্ধ করুন, তারপর চালু করুন। বিরতিতে কিছু রেকর্ড হয় না।" /></p>
      <div id="rs-typing" class="card panel">
        <p id="rs-role" class="eyebrow"></p>
        <p id="rs-rule" class="notice"></p>
        <div id="rs-input" tabindex="0" role="textbox" aria-label="Physical typing area" aria-readonly="true" aria-describedby="rs-input-help">
          <div id="rs-prompt" class="bn prompt"></div>
          <p id="rs-typed" class="bn typed"></p>
        </div>
        <p id="rs-input-help" class="tiny muted"><T en="Click the text area and type. Space separates words; Enter starts the text again after you reach its last word. Escape pauses. Time spent thinking counts; breaks do not." bn="লেখার জায়গায় ক্লিক করে টাইপ করুন। শব্দের মাঝে Space; শেষ শব্দে পৌঁছালে Enter দিয়ে লেখাটি আবার শুরু করুন। Escape-এ বিরতি। ভাবার সময় মাপে থাকবে; বিরতি থাকবে না।" /></p>
        <p id="rs-cue" class="cue" aria-live="polite"></p>
        <div id="rs-kb" class="keyboard-host"></div>
        <button type="button" class="btn primary" id="rs-measure"><T en="Ready — begin the first measured minute" bn="প্রস্তুত — প্রথম মিনিটের মাপ শুরু করুন" /></button>
      </div>
      <section id="rs-between" class="card panel" hidden>
        <h3 id="rs-between-title"></h3><p id="rs-between-text"></p>
        <div id="rs-rating" hidden>
          <label><T en="How comfortable was that block?" bn="এই পর্বে কতটা স্বচ্ছন্দ ছিলেন?" /><select id="rs-comfort"><option value="">Not rated / বলিনি</option><option value="1">1 — very awkward / খুব অস্বস্তিকর</option><option value="2">2</option><option value="3">3 — neutral / মাঝামাঝি</option><option value="4">4</option><option value="5">5 — very comfortable / খুব স্বচ্ছন্দ</option></select></label>
          <label><T en="Anything awkward? (optional)" bn="কোথাও অসুবিধা? (ইচ্ছা হলে লিখুন)" /><textarea id="rs-notes" maxlength="1000" rows="2"></textarea></label>
        </div>
        <button class="btn primary" id="rs-next" type="button"><T en="Continue when ready" bn="প্রস্তুত হলে চালিয়ে যান" /></button>
      </section>
    </section>

    <section id="rs-result" class="card panel" hidden>
      <p class="eyebrow"><T en="Your personal result" bn="আপনার ব্যক্তিগত ফল" /></p>
      <h2><T en="Copy this report back to the conversation" bn="এই প্রতিবেদন কপি করে আলাপে দিন" /></h2>
      <p><T en="It includes the exact maps, style, help, practice, block order, sample sizes, errors and ratings. An unfinished test stays marked unfinished. There is no automatic winner." bn="ঠিক কোন বিন্যাস, শৈলী, সাহায্য, অনুশীলন, পর্বের ক্রম, নমুনার পরিমাণ, ভুল ও মতামত আছে। অসমাপ্ত পরীক্ষা অসমাপ্তই লেখা থাকবে। স্বয়ংক্রিয়ভাবে কাউকে বিজয়ী বলা হবে না।" /></p>
      <div id="rs-summary" class="table-scroll"></div>
      <label><T en="Which entry style would you choose?" bn="কোন লেখার শৈলী বেছে নেবেন?" /><select id="rs-preference"><option value="unsure">Not sure yet / এখনও নিশ্চিত নই</option><option value="A">Goti / গতি</option><option value="D">Jhor / ঝড়</option><option value="equal">Either is fine / দুটিই ভালো</option></select></label>
      <div class="actions"><button id="rs-copy" type="button" class="btn primary"><T en="Copy report" bn="প্রতিবেদন কপি করুন" /></button><button id="rs-download" type="button" class="btn"><T en="Download full JSON" bn="সম্পূর্ণ JSON নামান" /></button><a class="btn" href="./"><T en="Start another session" bn="আরেকটি পরীক্ষা শুরু করুন" /></a></div>
      <p id="rs-copy-status" role="status"></p>
      <label><T en="Copyable report" bn="কপি করার প্রতিবেদন" /><textarea id="rs-report" readonly rows="16" spellcheck="false"></textarea></label>
    </section>
    <p class="tiny muted footnote"><T en="Local only. This research test does not upload anything or change course progress. The copyable report is saved in this browser when storage is available. Keep the full JSON if you want the original key and text events." bn="সব এই ডিভাইসেই। এই পরীক্ষা কিছু আপলোড করে না, পাঠের অগ্রগতিও বদলায় না। সংরক্ষণের সুবিধা থাকলে কপি করার প্রতিবেদন এই ব্রাউজারে থাকে। মূল কি ও লেখার রেকর্ড চাইলে সম্পূর্ণ JSON রেখে দিন।" /></p>
    <noscript><p>This research test needs JavaScript. / এই পরীক্ষার জন্য JavaScript চালু থাকতে হবে।</p></noscript>
  </div>
</Base>
<script>import '../../scripts/research.ts';</script>
<style>
  .research { max-width: 1000px; padding-top: 42px; }
  .intro { max-width: 760px; margin-bottom: 28px; }
  .lede { font-size: 1.08rem; color: var(--ink-2); }
  .panel { padding: 26px; margin: 18px 0; }
  .notice { padding: 14px 18px; background: var(--accent-soft); border-radius: 12px; margin: 20px 0; }
  .settings { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  label { display: grid; gap: 8px; font-weight: 550; margin-bottom: 16px; }
  select, textarea { width: 100%; padding: 11px; border: 1px solid var(--line-2); border-radius: 9px; background: var(--bg); color: var(--ink); font: inherit; }
  textarea { resize: vertical; font-weight: 400; }
  .work-top, .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; }
  .actions { justify-content: flex-start; margin: 16px 0; }
  #rs-input { padding: 16px; border: 2px solid var(--line); border-radius: 12px; min-height: 180px; }
  #rs-input:focus { outline: 3px solid var(--accent-soft); border-color: var(--accent); }
  .prompt { font-size: clamp(1.3rem, 3vw, 1.7rem); line-height: 1.9; max-height: 160px; overflow-y: auto; }
  .prompt :global(.hit) { color: var(--ok); }
  .prompt :global(.miss) { color: var(--bad); text-decoration: underline wavy; }
  .prompt :global(.todo) { color: var(--muted); }
  .typed { min-height: 1.8em; margin: 10px 0 0; font-size: 1.15rem; overflow-wrap: anywhere; }
  .cue { min-height: 30px; text-align: center; font-weight: 550; }
  .keyboard-host { margin: 16px 0 24px; overflow-x: auto; }
  .table-scroll { overflow-x: auto; margin-bottom: 18px; }
  #rs-report, #rs-previous-text { min-height: 250px; font: 12px/1.6 monospace; white-space: pre; }
  #rs-previous { margin-top: 24px; }
  .footnote { max-width: 760px; margin-top: 24px; }
  :global([hidden]) { display: none !important; }
  @media (max-width: 640px) { .settings { grid-template-columns: 1fr; gap: 4px; } .panel { padding: 16px; } .research { padding-top: 24px; } }
</style>
