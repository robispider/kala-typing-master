---
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-sans-bengali';
import '../styles/global.css';
import T from '../components/T.astro';

interface Props {
  title: string;
  description?: string;
  focus?: boolean; // practice mode: quieter chrome
}
const { title, description = 'Learn Bangla and English touch typing in your browser. Free, no login, no installation. Your progress stays on your device.', focus = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const nav = [
  { href: `${base}`, en: 'Home', bn: 'শুরু', match: (p: string) => p === base },
  { href: `${base}learn/`, en: 'Learn', bn: 'শিখুন', match: (p: string) => p.startsWith(`${base}learn`) || p.startsWith(`${base}practice`) },
  { href: `${base}library/`, en: 'Library', bn: 'পাঠাগার', match: (p: string) => p.startsWith(`${base}library`) },
  { href: `${base}progress/`, en: 'Progress', bn: 'অগ্রগতি', match: (p: string) => p.startsWith(`${base}progress`) },
  { href: `${base}about/`, en: 'About', bn: 'পরিচিতি', match: (p: string) => p.startsWith(`${base}about`) },
  { href: `${base}research/`, en: 'Research', bn: 'গবেষণা', match: (p: string) => p.startsWith(`${base}research`) },
];
// The Kala keyboard app's download pages, one per interface language.
const kalaApp = [
  { l: 'en', href: 'https://robispider.github.io/kala-releases/en/', label: 'Kala Keyboard', title: 'Get the Kala keyboard for Windows' },
  { l: 'bn', href: 'https://robispider.github.io/kala-releases/bn/', label: 'Kala কিবোর্ড', title: 'Windows-এর জন্য Kala কিবোর্ড নিন' },
];
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131210" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <script is:inline>
      // Apply the saved language and theme before first paint.
      try {
        const p = JSON.parse(localStorage.getItem('kala-learn:v1') || 'null');
        if (p && p.lang) { document.documentElement.dataset.lang = p.lang; document.documentElement.lang = p.lang; }
        if (p && p.settings && p.settings.theme && p.settings.theme !== 'auto') document.documentElement.dataset.theme = p.settings.theme;
      } catch (e) {}
    </script>
  </head>
  <body class:list={{ focus }}>
    <a class="skip" href="#main"><T en="Skip to content" bn="মূল অংশে যান" /></a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={base} aria-label="Kala Learn home">
          <img class="mark" src={`${base}kala-goat.png`} alt="" width="32" height="32" />
          <span class="word">Kala <b>Learn</b></span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.match(path) ? 'page' : undefined}><T en={n.en} bn={n.bn} /></a>
          ))}
          {kalaApp.map((k) => (
            <span data-l={k.l} lang={k.l}>
              <a class="app" href={k.href} title={k.title} target="_blank" rel="noopener">
                <img src={`${base}kala-goat-full.png`} alt="" width="14" height="24" />{k.label}<span class="ext" aria-hidden="true">↗</span>
              </a>
            </span>
          ))}
        </nav>
        <div class="tools">
          <button class="tool" type="button" id="lang-toggle" aria-label="Switch language / ভাষা বদলান">
            <span data-l="en">বাংলা</span><span data-l="bn">English</span>
          </button>
          <button class="tool icon" type="button" id="theme-toggle" aria-label="Switch theme">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    {!focus && (
      <footer class="site">
        <div class="wrap foot">
          <p>
            <T en="Kala Learn runs entirely in your browser. No account, no tracking — your progress is saved on this device." bn="Kala Learn পুরোপুরি আপনার ব্রাউজারে চলে। কোনো অ্যাকাউন্ট বা ট্র্যাকিং নেই — অগ্রগতি এই ডিভাইসেই সংরক্ষিত থাকে।" />
          </p>
          <p class="muted">
            <a href={`${base}about/`}><T en="Credits & licences" bn="কৃতজ্ঞতা ও লাইসেন্স" /></a> ·
            <a href="https://github.com/robispider/kala-typing-master">GitHub</a>
          </p>
        </div>
      </footer>
    )}
    <script>
      import { setLang, setTheme } from '../lib/i18n.ts';
      import { load } from '../lib/store.ts';
      document.getElementById('lang-toggle')?.addEventListener('click', () =>
        setLang(document.documentElement.dataset.lang === 'bn' ? 'en' : 'bn'));
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.dataset.theme
          ? document.documentElement.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        setTheme(dark ? 'light' : 'dark');
      });
      void load();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    background: var(--surface);
    padding: 8px 12px;
    border-radius: 8px;
    z-index: 10;
  }
  .skip:focus {
    left: 8px;
  }
  header.site {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  /* Kala Learn's mark: the Black Bengal goat's face on the pale green of the Kala site. */
  .mark {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #e5edda;
    object-fit: cover;
  }
  .word b {
    color: var(--accent);
    font-weight: 600;
  }
  nav {
    display: flex;
    gap: 2px;
    margin-left: 12px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav a {
    padding: 6px 12px;
    border-radius: 999px;
    text-decoration: none;
    color: var(--muted);
    font-weight: 550;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--ink);
    background: var(--bg-2);
  }
  nav a.app {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding-left: 5px;
    color: var(--ink-2);
  }
  /* The whole Black Bengal goat stands for the Kala keyboard app; the pale disc keeps it visible in dark mode. */
  nav a.app img {
    width: 26px;
    height: 26px;
    padding: 2px;
    border-radius: 50%;
    background: #e5edda;
    object-fit: contain;
  }
  nav a.app .ext {
    font-size: 0.75em;
    opacity: 0.6;
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .tools {
    margin-left: auto;
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .tool {
    height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 550;
    cursor: pointer;
  }
  .tool.icon {
    width: 34px;
    padding: 0;
    display: grid;
    place-items: center;
  }
  html[data-lang='en'] #lang-toggle,
  html:not([data-lang]) #lang-toggle {
    font-family: var(--font-bn);
  }
  main {
    flex: 1;
  }
  footer.site {
    border-top: 1px solid var(--line);
    margin-top: 72px;
    padding: 28px 0 40px;
    font-size: 0.92rem;
  }
  .foot p {
    margin: 0 0 6px;
  }
  @media (max-width: 760px) {
    .bar {
      flex-wrap: wrap;
      height: auto;
      padding-top: 10px;
      padding-bottom: 6px;
      row-gap: 6px;
    }
    nav {
      order: 3;
      width: 100%;
      margin: 0 -4px;
    }
    .word {
      display: none;
    }
  }
  body.focus footer.site {
    display: none;
  }
</style>
