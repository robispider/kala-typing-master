---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import { layouts } from '../../lib/catalog.ts';
import { keyboardHtml } from '../../lib/keyboard.ts';

export function getStaticPaths() {
  return layouts.map((l) => ({ params: { id: l.id } }));
}

const { id } = Astro.params;
const layout = layouts.find((l) => l.id === id)!;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={`Practice · ${layout.name.en} · Kala Learn`} focus>
  <div class="practice wrap" data-practice data-layout={id}>
    <div class="pr-top">
      <a class="btn ghost small" href={`${base}learn/${id}/`} aria-label="Back to the path">←</a>
      <div class="pr-titles">
        <span class="muted small"><T en={layout.name.en} bn={layout.name.bn} /></span>
        <b id="pr-title">&nbsp;</b>
      </div>
      <div class="pr-bar" id="pr-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"><span></span></div>
      <div class="pr-toggles">
        <label class="switch" title="Show a hint when you pause">
          <input type="checkbox" id="pr-hints" checked /><span><T en="Hints" bn="সাহায্য" /></span>
        </label>
        <label class="switch" title="Show the keyboard">
          <input type="checkbox" id="pr-showkb" checked /><span><T en="Keyboard" bn="কিবোর্ড" /></span>
        </label>
        <label class="switch" title="Show hands moving to the next key">
          <input type="checkbox" id="pr-hands" checked /><span><T en="Hands" bn="হাত" /></span>
        </label>
        <label class="switch" title="Colour each key by the finger that presses it">
          <input type="checkbox" id="pr-pastel" checked /><span><T en="Colours" bn="রং" /></span>
        </label>
      </div>
    </div>

    <div id="pr-workspace">
      <div class="pr-phase">
        <h2 id="pr-phase-title">&nbsp;</h2>
        <p id="pr-phase-text" class="muted"></p>
      </div>

      <div class="pr-card card" id="pr-card">
        <p class="pr-credit muted" id="pr-credit" hidden></p>
        <div class="pr-words bn" id="pr-words" aria-live="polite"></div>
        <div class="pr-typed bn" id="pr-typed" aria-label="What you typed"></div>
        <div class="pr-chips" id="pr-chips" hidden></div>
        <div class="pr-overlay" id="pr-overlay">
          <div class="ov-card"><div class="spinner" aria-hidden="true"></div><p><T en="Preparing your lesson…" bn="পাঠ তৈরি হচ্ছে…" /></p></div>
        </div>
      </div>

      <div class="pr-finger" id="pr-finger" aria-live="polite"></div>
      <div class="pr-kb" id="pr-kb" set:html={keyboardHtml(layout, { interactive: true })} />

      <dl class="pr-stats">
        <div><dt><T en="Accuracy" bn="নির্ভুলতা" /></dt><dd id="pr-acc">—</dd></div>
        <div><dt><T en="Letters/min" bn="অক্ষর/মিনিট" /></dt><dd id="pr-speed">—</dd></div>
        <div><dt><T en="Time" bn="সময়" /></dt><dd id="pr-time">0:00</dd></div>
        <div><dt><T en="Item" bn="অংশ" /></dt><dd id="pr-count">—</dd></div>
      </dl>
      <p class="pr-help muted">
        <kbd>Space</kbd> <T en="next word" bn="পরের শব্দ" /> · <kbd>⌫</kbd> <T en="fix" bn="মুছুন" /> ·
        <kbd>Tab</kbd> <T en="hint" bn="সাহায্য" /> · <kbd>Esc</kbd> <T en="pause" bn="বিরতি" />
      </p>
    </div>

    <section class="pr-results" id="pr-results" hidden aria-live="polite"></section>

    <div class="pr-ime card" id="pr-ime" role="alert" hidden>
      <p>
        <b><T en="Your computer’s Bangla keyboard is on." bn="আপনার কম্পিউটারের বাংলা কিবোর্ড চালু আছে।" /></b>
        <T en="Switch your system keyboard to English (US) — Kala types the Bangla here, so the two would compose twice." bn="সিস্টেম কিবোর্ড ইংরেজি (US)-তে বদলান — এখানে বাংলা Kala-ই লেখে, নইলে দুবার কম্পোজ হবে।" />
      </p>
      <button class="btn small" id="pr-ime-close" type="button"><T en="Got it" bn="বুঝেছি" /></button>
    </div>
  </div>
</Base>

<script src="../../scripts/practice.ts"></script>

<style>
  .practice {
    padding-top: 14px;
    padding-bottom: 32px;
    max-width: 980px;
  }
  .pr-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pr-titles {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
  }
  .small {
    font-size: 0.82rem;
  }
  .pr-bar {
    flex: 1;
    height: 6px;
    border-radius: 6px;
    background: var(--bg-2);
    overflow: hidden;
    min-width: 60px;
  }
  .pr-bar span {
    display: block;
    height: 100%;
    width: calc(var(--p, 0) * 100%);
    background: var(--accent);
    border-radius: 6px;
    transition: width 0.4s ease;
  }
  .pr-toggles {
    display: flex;
    gap: 6px;
  }
  .switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--muted);
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    cursor: pointer;
  }
  .switch input {
    accent-color: var(--accent);
    margin: 0;
  }
  :global(.practice.intro) .pr-phase {
    visibility: hidden;
  }
  .pr-phase {
    text-align: center;
    margin: 18px auto 12px;
    max-width: 640px;
  }
  .pr-phase h2 {
    font-size: 1.35rem;
    margin-bottom: 4px;
  }
  .pr-phase p {
    margin: 0;
    font-size: 0.95rem;
  }
  .pr-card {
    position: relative;
    padding: 26px 28px 22px;
    min-height: 236px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    overflow: hidden;
  }
  .pr-card.flash-ok {
    animation: okflash 0.5s ease;
  }
  .pr-card.flash-bad {
    animation: badflash 0.5s ease;
  }
  @keyframes okflash {
    30% {
      box-shadow: var(--shadow), inset 0 0 0 2px var(--ok);
    }
  }
  @keyframes badflash {
    30% {
      box-shadow: var(--shadow), inset 0 0 0 2px var(--bad);
    }
  }
  .pr-credit {
    font-size: 0.82rem;
    margin: 0 0 6px;
    text-align: center;
  }
  .pr-words {
    font-size: clamp(1.6rem, 4.2vw, 2.5rem);
    line-height: 1.6;
    text-align: center;
    max-height: 4.9em;
    overflow-y: auto;
    max-width: 100%;
    scrollbar-width: thin;
  }
  .pr-words :global(.w) {
    display: inline-block;
    padding: 0 0.08em;
    border-radius: 8px;
  }
  .pr-words :global(.w.todo) {
    color: var(--muted);
    opacity: 0.75;
  }
  .pr-words :global(.w.done.ok) {
    color: var(--ok);
  }
  .pr-words :global(.w.done.bad) {
    color: var(--bad);
    text-decoration: underline wavy color-mix(in srgb, var(--bad) 50%, transparent);
    text-underline-offset: 0.25em;
  }
  .pr-words :global(.w.now) {
    background: var(--accent-soft);
    padding: 0 0.18em;
    font-size: 1.12em;
  }
  .pr-words :global(.g) {
    color: var(--muted);
  }
  .pr-words :global(.g.hit) {
    color: var(--ink);
  }
  .pr-words :global(.g.miss) {
    color: var(--bad);
  }
  .pr-words :global(.g.next) {
    color: var(--ink-2);
    text-decoration: underline 2px var(--accent);
    text-underline-offset: 0.2em;
  }
  .pr-typed {
    font-size: 1.5rem;
    min-height: 2.3rem;
    color: var(--ink-2);
  }
  .pr-typed :global(.err) {
    color: var(--bad);
    background: var(--bad-soft);
    border-radius: 4px;
  }
  .pr-typed :global(.placeholder) {
    font-size: 0.95rem;
    color: var(--muted);
    font-family: var(--font);
  }
  .pr-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
  }
  .pr-chips :global(.chip) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px 4px 4px;
    border-radius: 10px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-family: var(--font-bn);
    font-size: 1.05rem;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .pr-chips :global(.chip kbd) {
    border: none;
    font-size: 0.8rem;
  }
  .pr-chips :global(.chip.done) {
    opacity: 0.4;
  }
  .pr-chips :global(.chip.now) {
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .pr-chips :global(.plus) {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .pr-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 20px;
    text-align: center;
    cursor: pointer;
    z-index: 2;
    overflow-y: auto;
  }
  .pr-overlay[hidden] {
    display: none;
  }
  .pr-overlay :global(.ov-card) {
    max-width: 460px;
  }
  .pr-overlay :global(h3) {
    font-size: 1.3rem;
  }
  .pr-overlay :global(.eyebrow) {
    margin-bottom: 6px;
  }
  .spinner {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 3px solid var(--line);
    border-top-color: var(--accent);
    margin: 0 auto 10px;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .pr-finger {
    min-height: 2.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 14px 0 8px;
    font-size: 0.95rem;
  }
  .pr-kb {
    position: relative;
    transition: opacity 0.2s ease;
  }
  /* Kala's hand library is drawn against 84-unit rows, a little flatter than square keys. */
  .pr-kb:global(.hands) :global(.key) {
    height: calc(var(--u) * 0.836);
  }
  .pr-kb :global(.hands-canvas) {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
  }
  :global(.practice.no-kb) .pr-kb {
    display: none;
  }
  .pr-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin: 20px auto 6px;
    max-width: 560px;
    text-align: center;
  }
  .pr-stats dt {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .pr-stats dd {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  .pr-help {
    text-align: center;
    font-size: 0.8rem;
  }
  .pr-ime {
    position: fixed;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    width: min(560px, calc(100vw - 32px));
    padding: 16px 18px;
    border-color: var(--accent);
    z-index: 20;
    font-size: 0.92rem;
  }
  .pr-ime p {
    margin: 0 0 8px;
  }
  .pr-results {
    display: grid;
    place-items: center;
    padding: 28px 0;
  }
  .pr-results :global(.res-card) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 32px;
    max-width: 640px;
    width: 100%;
    text-align: center;
  }
  .pr-results :global(.ring) {
    --v: 0;
    width: 132px;
    height: 132px;
    margin: 0 auto 18px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: conic-gradient(var(--ok) calc(var(--v) * 360deg), var(--bg-2) 0);
    animation: ringin 0.8s ease;
  }
  .pr-results :global(.ring span) {
    width: 108px;
    height: 108px;
    border-radius: 50%;
    background: var(--surface);
    display: flex;
    align-items: baseline;
    justify-content: center;
    padding-top: 30px;
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pr-results :global(.ring small) {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
    margin-left: 2px;
  }
  @keyframes ringin {
    from {
      transform: scale(0.85);
      opacity: 0;
    }
  }
  .pr-results :global(.res-stats) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin: 18px 0;
  }
  .pr-results :global(.res-stats dt) {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .pr-results :global(.res-stats dd) {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 650;
  }
  .pr-results :global(.res-units) {
    margin: 18px 0 0;
  }
  .pr-results :global(.res-units h3) {
    font-size: 0.9rem;
    color: var(--muted);
    font-weight: 600;
  }
  .pr-results :global(.res-units > div) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
  }
  .pr-results :global(.unit) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 10px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-family: var(--font-bn);
    font-size: 1.2rem;
  }
  .pr-results :global(.unit.m2),
  .pr-results :global(.unit.m3) {
    background: var(--ok-soft);
    border-color: var(--ok);
  }
  .pr-results :global(.res-actions) {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  @media (max-width: 640px) {
    .pr-toggles span {
      display: none;
    }
    .pr-top {
      flex-wrap: wrap;
    }
    .pr-titles {
      flex: 1;
    }
    .pr-bar {
      order: 3;
      flex-basis: 100%;
    }
    .pr-card {
      padding: 20px 14px 16px;
      min-height: 290px;
    }
    .pr-overlay :global(h3) {
      font-size: 1.1rem;
    }
    .pr-overlay :global(p) {
      font-size: 0.92rem;
    }
    .pr-stats,
    .pr-results :global(.res-stats) {
      grid-template-columns: repeat(2, 1fr);
    }
    .pr-results :global(.res-card) {
      padding: 22px 16px;
    }
    .pr-help {
      display: none;
    }
  }
</style>
